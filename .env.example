# FloodWatch Nigeria: environment variables.
#
# Copy this file to .env.local and fill in what you need.  NEVER commit .env.local or any real secret.
# For local development you can leave EVERYTHING unset: the app then uses a local JSON file for storage and keeps
# the optional features (gauge ingestion, daily jobs, moderation, phone alerts) switched off.
#
# Every variable is documented in docs/CONFIGURATION.md.
#
# Generate a strong secret (needed for every *_KEY / *_SECRET below):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Secrets shorter than 24 characters are REFUSED and the endpoint they protect stays disabled.

# ---- Storage ----------------------------------------------------------------------------------------------------
# Postgres connection string (Neon, Supabase, RDS, a container...). REQUIRED in production and on Vercel.
# If unset, a local JSON file is used (development only: it cannot persist on serverless hosts).
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Where the local JSON file lives when DATABASE_URL is not set. Default: ./data/db.json
# FLOODWATCH_DB=./data/db.json

# ---- Endpoint secrets (each endpoint stays disabled until its secret is set) ---------------------------------------
# Partners pushing river-gauge readings: POST /api/gauges
# GAUGE_API_KEY=
# Daily jobs: GET /api/cron/snapshot and /api/cron/alerts (Vercel sends this automatically)
# CRON_SECRET=
# Moderation screen and API: /admin and /api/admin/*
# ADMIN_API_KEY=

# ---- Abuse protection -------------------------------------------------------------------------------------------
# Your public address, e.g. https://floodwatch.example . Pins which website may submit reports (CSRF defence).
# Strongly recommended in production. Also used for the unsubscribe link in alert messages.
# SITE_ORIGIN=
# Behind a CDN or proxy, name the header that carries the real visitor IP, so rate limits work per person:
#   Cloudflare: cf-connecting-ip      Vercel: x-vercel-forwarded-for      nginx: x-real-ip
# If unset, the rightmost X-Forwarded-For value is used.
# TRUSTED_IP_HEADER=
# Bot protection for the report and sign-up forms (free): https://dash.cloudflare.com/?to=/:account/turnstile
# Set BOTH or neither. Strongly recommended before launch.
# TURNSTILE_SECRET=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Legal pages ------------------------------------------------------------------------------------------------
# Shown on /privacy and /terms. The "Draft, not reviewed by a lawyer" banner stays until LEGAL_REVIEWED=true.
# Have a qualified Nigerian lawyer review those pages first.
# CONTACT_EMAIL=
# LEGAL_REVIEWED=true

# ---- Phone alerts (SMS / WhatsApp). The whole feature stays OFF unless the first three are set --------------------
# Which service sends the messages: termii, twilio, or dry-run (sends nothing; for testing).
# SMS_PROVIDER=dry-run
# Encrypts phone numbers in the database. 64 hex characters (the command above makes one).
# LOSE IT AND YOU LOSE THE SUBSCRIBERS: back it up with your other secrets.
# PII_ENCRYPTION_KEY=
# (SITE_ORIGIN above is also required for alerts.)
# Hard limit on messages (codes + alerts) in any rolling 24 hours. Default 300.
# SMS_DAILY_CAP=300
# SAFETY SWITCH. Until this is exactly "true" the alert job only REPORTS what it would send.
# Do not turn it on until the thresholds have been checked with NiMet/NiHSA: a false alarm by SMS does real harm.
# ALERTS_LIVE=true

# Termii (Nigerian provider). The "dnd" route must be activated on your Termii account for reliable delivery.
# TERMII_API_KEY=
# TERMII_BASE_URL=https://your-termii-base-url
# TERMII_SENDER_ID=FloodWatch
# dnd (transactional, default) or generic (promotional: NOT recommended for verification codes)
# TERMII_SMS_CHANNEL=dnd
# Your WhatsApp device name, only if you offer WhatsApp through Termii
# TERMII_WHATSAPP_FROM=

# Twilio (SMS and WhatsApp)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# SMS sender: a Twilio number (+1...) OR a Messaging Service SID (MG...)
# TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=
# WhatsApp sender (whatsapp:+1...) and your WhatsApp-approved message templates (HX...), needed to message people
# who have not messaged you in the last 24 hours
# TWILIO_WHATSAPP_FROM=
# TWILIO_WHATSAPP_ALERT_CONTENT_SID=
# TWILIO_WHATSAPP_OTP_CONTENT_SID=

# ---- Development and testing only -------------------------------------------------------------------------------
# Dry-run provider: also append full messages (including one-time codes) to this file, for end-to-end tests.
# DRY_RUN_OUTBOX=/tmp/outbox.jsonl
# Run the storage tests against a real Postgres too:
#   TEST_DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/dbname npm test
#
# (NODE_ENV and VERCEL are set by Node and the hosting platform. You never set them yourself.)
